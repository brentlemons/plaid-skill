# Environment contract for the plaid-balance skill.
#
# This file is the single place these four variable names are defined. The
# helper script, the setup runbook, and the README all spell them exactly as
# they appear below; a test asserts that they still agree.
#
# ---------------------------------------------------------------------------
# WHERE TO PUT YOUR REAL VALUES
# ---------------------------------------------------------------------------
# Real credentials do not belong in this repository, not even in a gitignored
# file. Copy this file to the skill's environment file outside the repository:
#
#     ~/.hermes/plaid-balance.env
#
# and fill it in there. The helper script reads the process environment first
# and falls back to that file. Set PLAID_BALANCE_ENV_FILE if you keep it
# somewhere else.
#
# A copy inside the repository named .env is gitignored and may hold Plaid
# Sandbox values only. Sandbox data is synthetic, so nothing real leaks if that
# file is mishandled. Production values never go there.
#
# ---------------------------------------------------------------------------
# THE VARIABLES
# ---------------------------------------------------------------------------

# From the Plaid dashboard, Developers -> Keys. The same client ID is used for
# every environment.
PLAID_CLIENT_ID=your-client-id-here

# From the same page. Sandbox and Production each have their own secret; use
# the one matching PLAID_ENV below.
PLAID_SECRET=your-secret-here

# Produced by the setup runbook, at the /item/public_token/exchange step. This
# is the long-lived credential for one linked bank connection. Treat it the way
# you would treat the bank password itself.
PLAID_ACCESS_TOKEN=your-access-token-here

# Which Plaid host to call: sandbox or production. There is no default; the
# script refuses to guess which environment a money question is about.
PLAID_ENV=sandbox

# ---------------------------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------------------------
# PLAID_BALANCE_ENV_FILE overrides where the script looks when a variable is
# missing from the process environment. It is a path, so it cannot be set from
# inside this file — export it in your shell instead. Defaults to
# ~/.hermes/plaid-balance.env
